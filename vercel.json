{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_PUBLIC_DEMO=true npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/demo.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/demo?route=:path*"
    }
  ]
}
