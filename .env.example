HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data
# Set a long random token before enabling operator access.
OPERATOR_TOKEN=
# Meta Model API key; the OpenAI service is not used.
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
# Blank finds a local .tools install, then kane-cli on PATH.
KANE_BIN=
# Authenticate separately with kane-cli login. Credentials stay in Kane's profile.
KANE_TIMEOUT_SECONDS=180
KANE_MAX_STEPS=35
COOKIE_SECURE=false
